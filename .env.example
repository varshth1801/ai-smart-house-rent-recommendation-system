# ========================================================
# SMART RENT AI - ENVIRONMENT CONFIGURATION
# ========================================================

# Application Port
PORT=8080

# Spring Active Profiles:
# Set to 'default' for automatic embedded in-memory H2 (zero setup required!)
# Set to 'mysql' to connect to a local or cloud MySQL server
SPRING_PROFILES_ACTIVE=default

# MySQL Database Configuration (when SPRING_PROFILES_ACTIVE=mysql)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_rent_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# JWT Security Secret & Expiration
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRATION_MS=86400000

# AI Provider Configuration (optional: Gemini / OpenAI API key)
# If left blank, the built-in rule-based AI heuristic engine operates flawlessly offline!
AI_PROVIDER=internal
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Frontend URL (Vite dev server)
FRONTEND_URL=http://localhost:5173
